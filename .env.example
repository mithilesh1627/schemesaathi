# =============================================================================
# SchemeSaathi Environment Configuration Template (.env.example)
# DO NOT COMMIT PRODUCTION SECRETS TO REPOSITORY
# =============================================================================

# Core Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://schemesaathi:schemesaathi_dev_password@localhost:5432/schemesaathi_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_ECHO=false

# Redis Cache & Leaky Bucket
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["*"]
SECRET_KEY=change-this-in-production-vault-to-a-cryptographically-secure-random-token
